// Leads and payments for the ₹299 Revenue Strategy Session.
// After editing: `npm run db:migrate` (creates a migration + regenerates the client).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A booking-form submission. Saved before checkout, so abandoned payments
/// still show up in the dashboard.
model Lead {
  id        String    @id @default(cuid())
  name      String
  phone     String // 10-digit Indian mobile, no +91
  email     String?
  city      String?
  specialty String?
  pageUrl   String? // page the form was submitted from, incl. UTM params
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]

  @@index([createdAt])
  @@index([phone])
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

/// One Razorpay order for a lead. Created when checkout opens; updated once
/// the payment is verified with Razorpay.
model Payment {
  id                String        @id @default(cuid())
  leadId            String
  lead              Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Int // paise
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String? // upi, card, netbanking, wallet…
  email             String? // as entered in Razorpay checkout
  contact           String?
  errorReason       String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([leadId])
  @@index([status])
}
