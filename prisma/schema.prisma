// Leads and payments for the ₹299 Revenue Strategy Session.
// After editing: `npm run db:migrate` (creates a migration + regenerates the client).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A booking-form submission. Saved before checkout, so abandoned payments
/// still show up in the dashboard.
model Lead {
  id    String  @id @default(cuid())
  name  String
  phone String // 10-digit Indian mobile, no +91
  email String?

  // Clinic
  clinicName String?
  city       String? // city and area, as typed
  specialty  String?

  // Qualification — stored as the option label the clinic picked, so the
  // dashboard stays readable without a lookup table.
  enquiryHandler String?
  adSpend        String?
  monthlyRevenue String?
  decisionMaker  String?
  goal           String? // "why now", free text

  /// Chosen session slot, as a UTC instant. Slot times are defined in IST in
  /// lib/booking.ts. Deliberately NOT unique: an unpaid lead only holds its
  /// slot for HOLD_MINUTES (lib/slots.ts), after which the slot is offered
  /// again — otherwise every abandoned checkout would burn a slot forever.
  slotAt DateTime?

  pageUrl   String? // page the form was submitted from, incl. UTM params
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]

  @@index([createdAt])
  @@index([phone])
  @@index([slotAt])
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
}

/// One Razorpay order for a lead. Created when checkout opens; updated once
/// the payment is verified with Razorpay.
model Payment {
  id                String        @id @default(cuid())
  leadId            String
  lead              Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Int // paise
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  method            String? // upi, card, netbanking, wallet…
  email             String? // as entered in Razorpay checkout
  contact           String?
  errorReason       String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([leadId])
  @@index([status])
}
